# Copy to .env and add your API keys
VITE_TMDB_API_KEY=
# Game catalog — IGDB via Twitch (primary): https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional fallback if RAWG is up: https://rawg.io/apidocs
RAWG_API_KEY=
# MusicBrainz — no API key; contact URL or email for User-Agent (https://musicbrainz.org/doc/MusicBrainz_API)
MUSICBRAINZ_CONTACT=joelboard.vercel.app

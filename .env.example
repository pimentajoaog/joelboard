# Copy to .env and add your API keys
# Film/series search (Prateleira) — server-side only, no VITE_ prefix
# Vercel: enable for Production (and Preview if you use preview URLs), then redeploy
TMDB_API_KEY=
# Game catalog — IGDB via Twitch (primary): https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional fallback if RAWG is up: https://rawg.io/apidocs
RAWG_API_KEY=
# MusicBrainz — no API key; contact URL or email for User-Agent (https://musicbrainz.org/doc/MusicBrainz_API)
MUSICBRAINZ_CONTACT=joelboard.vercel.app
# Hub Novidades — Google Sheet ID (aba Novidades, colunas App | Kind | Text). Compartilhe leitura pública.
VITE_HUB_NEWS_SHEET_ID=
# Recipes online search cascade: Spoonacular → Foodashi → TheMealDB
# 1) Spoonacular free (50 pts/day): https://spoonacular.com/food-api/console#Profile  (signup on THEIR site, not RapidAPI)
SPOONACULAR_KEY=
# 2) Optional Foodashi Hobby (10k/mo) if Spoonacular quota is exhausted: https://foodashi.com/
FOODASHI_KEY=
# 3) TheMealDB always works without a key (test key "1"). Optional paid key:
# THEMEALDB_KEY=

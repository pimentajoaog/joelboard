{
  "manifest_version": 3,
  "name": "Joelboard Mini",
  "short_name": "Mini",
  "version": "2.0.1",
  "description": "Joelboard Mini — Replace (expansão de texto) e Refresh (auto-reload) numa só extensão.",
  "permissions": ["storage", "clipboardRead", "tabs", "scripting", "alarms"],
  "host_permissions": ["https://www.googleapis.com/*", "https://joelboard.vercel.app/*"],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
  "web_accessible_resources": [{
    "resources": [
      "replace/prompt.html",
      "replace/prompt-frame.js",
      "replace/lib/shared.js"
    ],
    "matches": ["<all_urls>"]
  }],
  "externally_connectable": {
    "matches": ["https://joelboard.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Joelboard Mini",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "192": "icons/icon-192.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://joelboard.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["replace/hub-bridge.js"],
    "run_at": "document_start"
  }],
  "commands": {
    "toggle-refresh": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Alternar auto-refresh nesta aba"
    }
  }
}

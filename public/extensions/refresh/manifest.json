{
  "manifest_version": 3,
  "name": "Joelboard Refresh",
  "short_name": "Refresh",
  "version": "1.2.1",
  "description": "Auto-refresh da aba atual — intervalo configurável, atalho e pausa em aba inativa. Parte do Joelboard Mini.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
  "externally_connectable": {
    "matches": ["https://joelboard.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Joelboard Refresh",
    "default_icon": {
      "16": "icons/icon-192.png",
      "48": "icons/icon-192.png",
      "128": "icons/icon-192.png"
    }
  },
  "icons": {
    "16": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}

{
  "manifest_version": 3,
  "name": "Joelboard Refresh",
  "short_name": "Refresh",
  "version": "1.0.1",
  "description": "Expansão de texto leve — templates, gatilhos e variáveis. Parte do Joelboard Mini.",
  "permissions": ["storage", "clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Joelboard Refresh",
    "default_icon": {
      "16": "icons/icon-192.png",
      "48": "icons/icon-192.png",
      "128": "icons/icon-192.png"
    }
  },
  "icons": {
    "16": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/shared.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}

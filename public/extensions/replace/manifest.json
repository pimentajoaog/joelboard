{
  "manifest_version": 3,
  "name": "Joelboard Replace",
  "short_name": "Replace",
  "version": "1.5.3",
  "description": "Expansão de texto leve — templates, gatilhos e variáveis. Parte do Joelboard Mini.",
  "permissions": ["storage", "clipboardRead", "tabs", "scripting"],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
  "web_accessible_resources": [{
    "resources": ["prompt.html", "prompt-frame.js", "lib/shared.js"],
    "matches": ["<all_urls>"]
  }],
  "externally_connectable": {
    "matches": ["https://joelboard.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Joelboard Replace",
    "default_icon": {
      "16": "icons/icon-192.png",
      "48": "icons/icon-192.png",
      "128": "icons/icon-192.png"
    }
  },
  "icons": {
    "16": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}

{
  "manifest_version": 3,
  "name": "Joelboard Report",
  "short_name": "Report",
  "version": "1.0.1",
  "description": "Relatórios recorrentes com contadores — copiar para Slack. Parte do Joelboard Mini.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Joelboard Report",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "192": "icons/icon-192.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
